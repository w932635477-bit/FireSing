# ========================================
# FireSing 部署配置
# 复制此文件为 .env 并填写实际值
# ========================================

# --- 域名 ---
DOMAIN=firesing.cn

# --- 微信开放平台 (PC 扫码登录) ---
# 在 open.weixin.qq.com 创建网站应用获取
WECHAT_OPEN_APP_ID=
WECHAT_OPEN_APP_SECRET=

# --- 微信公众号 (微信内登录) ---
# 在 mp.weixin.qq.com 已认证服务号获取
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=

# --- 微信支付 ---
# 在 pay.weixin.qq.com 商户平台获取
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_KEY=
WECHAT_PAY_NOTIFY_URL=https://firesing.cn/api/payments/wechat/callback

# --- GPU 服务器 (AutoDL) ---
GPU_SERVER_URL=http://localhost:8001

# --- 音乐下载服务 (go-music-dl) ---
MUSIC_DL_URL=http://localhost:8090/music

# --- JWT ---
JWT_SECRET=change-this-to-a-random-32-char-string

# --- 前端 ---
NEXT_PUBLIC_API_URL=

# --- 数据库 ---
DATABASE_URL=sqlite:///data/firesing.db
