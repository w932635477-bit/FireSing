# ========================================
# FireSing 部署配置
# 复制此文件为 .env 并填写实际值
# ========================================

# --- 域名 ---
DOMAIN=firesing.cn

# --- GPU 服务器 (AutoDL) ---
# 使用 AutoDL 的端口转发地址
# 格式: http://<autodl-address>:<port>
GPU_SERVER_URL=http://localhost:8001

# --- 音乐下载服务 (go-music-dl) ---
MUSIC_DL_URL=http://localhost:8090/music

# --- 微信登录 (Phase 2, 先留空) ---
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# --- 微信支付 (Phase 2, 先留空) ---
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_KEY=
WECHAT_PAY_NOTIFY_URL=https://${DOMAIN}/api/payments/wechat/callback

# --- JWT ---
JWT_SECRET=change-this-to-a-random-32-char-string

# --- 前端 ---
NEXT_PUBLIC_API_URL=

# --- 数据库 ---
DATABASE_URL=sqlite:///data/firesing.db
